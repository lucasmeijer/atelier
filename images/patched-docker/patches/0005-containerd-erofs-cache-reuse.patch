+// reusableCacheBlob only accepts complete, atomically published cache files.
+func reusableCacheBlob(path string) (bool, error) {
+	info, err := os.Stat(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	if !info.Mode().IsRegular() || info.Size() < 4096 {
+		return false, fmt.Errorf("invalid cached EROFS layer: %s", path)
+	}
+	return true, nil
+}

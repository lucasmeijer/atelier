+++ b/vendor/github.com/moby/buildkit/snapshot/mountmanager_test.go
@@ -0,0 +1,144 @@
+package snapshot
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/containerd/containerd/v2/core/mount"
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+	"github.com/containerd/errdefs"
+	"github.com/moby/sys/user"
+)
+
+type testMountable struct{ releases int }
+
+func (m *testMountable) Mount() ([]mount.Mount, func() error, error) {
+	return []mount.Mount{{Type: "format/mkdir/overlay", Source: "overlay", Options: []string{"lowerdir={{ overlay 0 2 }}"}}}, func() error { m.releases++; return nil }, nil
+}
+func (*testMountable) IdentityMapping() *user.IdentityMapping { return nil }
+
+type testMountManager struct {
+	mount.Manager
+	t                      *testing.T
+	activates, deactivates int
+	fail                   error
+	keys                   map[string]bool
+}
+
+func (m *testMountManager) Activate(ctx context.Context, key string, raw []mount.Mount, opts ...mount.ActivateOpt) (mount.ActivationInfo, error) {
+	m.activates++
+	if ctx.Err() != nil {
+		m.t.Fatal("activation reused expired lookup context")
+	}
+	ns, _ := namespaces.Namespace(ctx)
+	if ns != "moby" {
+		m.t.Fatalf("namespace = %q", ns)
+	}
+	if raw[0].Type != "format/mkdir/overlay" {
+		m.t.Fatal("missing raw mount")
+	}
+	if m.keys[key] {
+		m.t.Fatal("activation names must be distinct")
+	}
+	m.keys[key] = true
+	var cfg mount.ActivateOptions
+	for _, opt := range opts {
+		opt(&cfg)
+	}
+	if cfg.Temporary {
+		m.t.Fatal("must not request temporary activation")
+	}
+	if cfg.Labels["containerd.io/gc.bref.snapshot.erofs"] != "snapshot-key" {
+		m.t.Fatal("missing GC back-reference")
+	}
+	return mount.ActivationInfo{System: []mount.Mount{{Type: "bind", Source: "/resolved", Options: []string{"rbind"}}}}, m.fail
+}
+func (m *testMountManager) Deactivate(ctx context.Context, key string) error {
+	m.deactivates++
+	if ctx.Err() != nil {
+		m.t.Fatal("cleanup context is canceled")
+	}
+	ns, _ := namespaces.Namespace(ctx)
+	if ns != "moby" {
+		m.t.Fatal("cleanup lost namespace")
+	}
+	if !m.keys[key] {
+		m.t.Fatal("wrong activation key")
+	}
+	return nil
+}
+func TestManagedMountLifetime(t *testing.T) {
+	ctx, cancel := context.WithCancel(namespaces.WithNamespace(context.Background(), "moby"))
+	mm := &testMountManager{t: t, keys: map[string]bool{}}
+	raw := &testMountable{}
+	m := &managedMountable{Mountable: raw, ctx: ctx, manager: mm, snapshotter: "erofs", key: "snapshot-key"}
+	mounts, release, err := m.Mount()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(mounts) != 1 || mounts[0].Type != "bind" || mounts[0].Source != "/resolved" {
+		t.Fatal(mounts)
+	}
+	_, release2, err := m.Mount()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cancel()
+	if err := release(); err != nil {
+		t.Fatal(err)
+	}
+	if err := release(); err != nil {
+		t.Fatal(err)
+	}
+	if err := release2(); err != nil {
+		t.Fatal(err)
+	}
+	if mm.activates != 2 || mm.deactivates != 2 || raw.releases != 2 {
+		t.Fatalf("lifetime counts %d %d %d", mm.activates, mm.deactivates, raw.releases)
+	}
+}
+func TestManagedMountActivationFailure(t *testing.T) {
+	fail := errors.New("activation failed")
+	mm := &testMountManager{t: t, fail: fail, keys: map[string]bool{}}
+	raw := &testMountable{}
+	m := &managedMountable{Mountable: raw, ctx: namespaces.WithNamespace(context.Background(), "moby"), manager: mm, snapshotter: "erofs", key: "snapshot-key"}
+	mounts, release, err := m.Mount()
+	if !errors.Is(err, fail) || mounts != nil || release != nil {
+		t.Fatalf("unexpected result: %v %v", mounts, err)
+	}
+	if raw.releases != 1 || mm.deactivates != 0 {
+		t.Fatal("incorrect failed activation cleanup")
+	}
+}
+
+func TestManagedMountSystemMounts(t *testing.T) {
+	mm := &testMountManager{t: t, fail: errdefs.ErrNotImplemented, keys: map[string]bool{}}
+	raw := &testMountable{}
+	m := &managedMountable{Mountable: raw, ctx: namespaces.WithNamespace(context.Background(), "moby"), manager: mm, snapshotter: "erofs", key: "snapshot-key"}
+	mounts, release, err := m.Mount()
+	if err != nil || len(mounts) != 1 {
+		t.Fatalf("%v %v", mounts, err)
+	}
+	if err := release(); err != nil {
+		t.Fatal(err)
+	}
+	if raw.releases != 1 || mm.deactivates != 0 {
+		t.Fatal("system mount cleanup")
+	}
+}
+
+func TestManagedMountAfterLookupCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(namespaces.WithNamespace(context.Background(), "moby"))
+	cancel()
+	mm := &testMountManager{t: t, keys: map[string]bool{}}
+	raw := &testMountable{}
+	m := &managedMountable{Mountable: raw, ctx: ctx, manager: mm, snapshotter: "erofs", key: "snapshot-key"}
+	_, release, err := m.Mount()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := release(); err != nil {
+		t.Fatal(err)
+	}
+}

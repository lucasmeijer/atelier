Atelier downstream patch against vendored BuildKit v0.31.0.
Direction: https://github.com/containerd/containerd/issues/14015
Resolve mount-manager instructions and fetch only layers that need applying.
The opt-in image exporter flag is store-allow-incomplete=true.
Original compressed blobs are still needed for save/push to an empty registry.
This changes embedded BuildKit only, not docker-container builder images.

diff --git a/vendor/github.com/moby/buildkit/snapshot/mountmanager.go b/vendor/github.com/moby/buildkit/snapshot/mountmanager.go
new file mode 100644
--- /dev/null
+++ b/vendor/github.com/moby/buildkit/snapshot/mountmanager.go
@@ -0,0 +1,98 @@
+package snapshot
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/mount"
+	"github.com/containerd/containerd/v2/core/snapshots"
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+	"github.com/containerd/errdefs"
+	"github.com/moby/buildkit/identity"
+	"github.com/moby/sys/user"
+)
+
+// WithMountManager resolves containerd mount instructions at the Mountable
+// boundary, so executors, local mounters, and exporters receive system mounts.
+func WithMountManager(s Snapshotter, manager mount.Manager, namespace string) Snapshotter {
+	return &managedSnapshotter{Snapshotter: s, manager: manager, namespace: namespace}
+}
+
+type managedSnapshotter struct {
+	Snapshotter
+	manager   mount.Manager
+	namespace string
+}
+
+func (s *managedSnapshotter) Mounts(ctx context.Context, key string) (Mountable, error) {
+	m, err := s.Snapshotter.Mounts(ctx, key)
+	if err != nil {
+		return nil, err
+	}
+	return s.wrap(ctx, key, m), nil
+}
+
+func (s *managedSnapshotter) View(ctx context.Context, key, parent string, opts ...snapshots.Opt) (Mountable, error) {
+	m, err := s.Snapshotter.View(ctx, key, parent, opts...)
+	if err != nil {
+		return nil, err
+	}
+	return s.wrap(ctx, key, m), nil
+}
+
+func (s *managedSnapshotter) wrap(ctx context.Context, key string, m Mountable) Mountable {
+	return &managedMountable{Mountable: m, ctx: namespaces.WithNamespace(context.WithoutCancel(ctx), s.namespace), manager: s.manager, snapshotter: s.Name(), key: key}
+}
+
+type managedMountable struct {
+	Mountable
+	ctx              context.Context
+	manager          mount.Manager
+	snapshotter, key string
+}
+
+func (m *managedMountable) IdentityMapping() *user.IdentityMapping {
+	return m.Mountable.IdentityMapping()
+}
+
+func (m *managedMountable) Mount() ([]mount.Mount, func() error, error) {
+	raw, release, err := m.Mountable.Mount()
+	if err != nil {
+		return nil, nil, err
+	}
+	name := "buildkit-" + identity.NewID()
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(m.ctx), 10*time.Second)
+	defer cancel()
+	active, err := m.manager.Activate(ctx, name, raw, mount.WithLabels(map[string]string{
+		// If the client disappears before release, snapshot deletion permits GC
+		// to clean up the orphan activation and its EROFS mounts.
+		"containerd.io/gc.bref.snapshot." + m.snapshotter: m.key,
+	}))
+	if errdefs.IsNotImplemented(err) {
+		// The manager uses this response when every mount is already a system mount.
+		return raw, release, nil
+	}
+	if err != nil {
+		if release != nil {
+			err = errors.Join(err, release())
+		}
+		return nil, nil, fmt.Errorf("activate buildkit snapshot %s: %w", m.key, err)
+	}
+	var once sync.Once
+	var releaseErr error
+	return setRedirectDir(active.System, getRedirectDirOption()), func() error {
+		once.Do(func() {
+			// Build cancellation must not cancel mount cleanup.
+			ctx, cancel := context.WithTimeout(context.WithoutCancel(m.ctx), 10*time.Second)
+			defer cancel()
+			releaseErr = m.manager.Deactivate(ctx, name)
+			if release != nil {
+				releaseErr = errors.Join(releaseErr, release())
+			}
+		})
+		return releaseErr
+	}, nil
+}
diff --git a/vendor/github.com/moby/buildkit/snapshot/mountmanager_test.go b/vendor/github.com/moby/buildkit/snapshot/mountmanager_test.go
new file mode 100644

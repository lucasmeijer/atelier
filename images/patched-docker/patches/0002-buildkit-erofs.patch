+++ b/vendor/github.com/moby/buildkit/exporter/containerimage/lazyapply_test.go
@@ -0,0 +1,69 @@
+package containerimage
+
+import (
+	"bytes"
+	"context"
+	"testing"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/containerd/v2/core/diff"
+	"github.com/containerd/containerd/v2/core/mount"
+	"github.com/containerd/containerd/v2/plugins/content/local"
+	digest "github.com/opencontainers/go-digest"
+	ocispec "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+type countingProvider struct {
+	content.Provider
+	reads int
+}
+
+func (p *countingProvider) ReaderAt(ctx context.Context, d ocispec.Descriptor) (content.ReaderAt, error) {
+	p.reads++
+	return p.Provider.ReaderAt(ctx, d)
+}
+
+type checkingApplier struct {
+	t     *testing.T
+	store content.Store
+	calls int
+}
+
+func (a *checkingApplier) Apply(ctx context.Context, d ocispec.Descriptor, _ []mount.Mount, _ ...diff.ApplyOpt) (ocispec.Descriptor, error) {
+	a.calls++
+	if _, err := a.store.Info(ctx, d.Digest); err != nil {
+		a.t.Fatal("Apply received unavailable blob", err)
+	}
+	return d, nil
+}
+func TestFetchOnlyAppliedMissingBlob(t *testing.T) {
+	ctx := context.Background()
+	src, err := local.NewStore(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	dst, err := local.NewStore(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	data := []byte("new layer bytes")
+	d := ocispec.Descriptor{Digest: digest.FromBytes(data), Size: int64(len(data)), MediaType: ocispec.MediaTypeImageLayer}
+	if err := content.WriteBlob(ctx, src, "source", bytes.NewReader(data), d); err != nil {
+		t.Fatal(err)
+	}
+	provider := &countingProvider{Provider: src}
+	applier := &checkingApplier{t: t, store: dst}
+	a := fetchOnApply{Applier: applier, store: dst, provider: provider}
+	if _, err := a.Apply(ctx, d, nil); err != nil {
+		t.Fatal(err)
+	}
+	if provider.reads != 1 || applier.calls != 1 {
+		t.Fatal("missing blob was not materialized exactly once")
+	}
+	if _, err := a.Apply(ctx, d, nil); err != nil {
+		t.Fatal(err)
+	}
+	if provider.reads != 1 || applier.calls != 2 {
+		t.Fatal("existing blob was fetched again")
+	}
+}

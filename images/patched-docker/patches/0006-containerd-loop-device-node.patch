 	loopControlPath = "/dev/loop-control"
 	loopDevFormat   = "/dev/loop%d"
+	loopMajor       = 7
 
 	ebusyString = "device or resource busy"
 )
@@ -61,6 +62,17 @@
 	return uint32(num), nil
 }
 
+// createLoopDevNode makes /dev/loopN after GET_FREE. The ioctl does not
+// create the directory entry; container /dev is not live devtmpfs.
+func createLoopDevNode(num uint32) error {
+	path := fmt.Sprintf(loopDevFormat, num)
+	err := unix.Mknod(path, unix.S_IFBLK|0660, int(unix.Mkdev(loopMajor, num)))
+	if err == nil || errors.Is(err, unix.EEXIST) {
+		return nil
+	}
+	return fmt.Errorf("could not create loop device %s: %w", path, err)
+}

{
  "name": "atelier",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "check": "bunx tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "ci": "bun ci && bun run check && bun test",
    "atelier": "bun run tools/atelier/src/main.ts",
    "web": "bun run --cwd apps/web build:client && bun --watch run apps/web/src/server/main.ts",
    "smoke:vscode": "node apps/web/smoke/vscode-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "bun-types": "1.3.14",
    "typescript": "6.0.3"
  }
}

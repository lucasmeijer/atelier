{
  "name": "atelier",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@earendil-works/pi-ai": "^0.84.2",
      "@earendil-works/pi-coding-agent": "^0.84.2"
    }
  },
  "scripts": {
    "generate:workspace-modules": "bun run --cwd apps/web scripts/generate-workspace-modules.ts",
    "image:build": "bun run scripts/build-atelier-image.ts",
    "image:publish": "bun run scripts/build-atelier-image.ts --push --platform linux/amd64",
    "docker:dev": "bun run scripts/run-atelier-docker-dev.ts",
    "check": "bun run generate:workspace-modules && bun run lint && bunx tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "test": "bun run generate:workspace-modules && bun test --parallel=4 --parallel-delay=0",
    "ci": "bun ci && bun run check && bun run test",
    "web": "bun run --cwd apps/web dev",
    "preview:redesign": "bun run scripts/run-redesign-preview.ts",
    "prototype:dark-foundation": "bun run scripts/serve-dark-foundation-prototypes.ts",
    "kill": "bun run --cwd apps/web kill",
    "list": "bun run --cwd apps/web list",
    "smoke:vscode": "node apps/web/smoke/vscode-smoke.mjs",
    "demo:recording": "bun apps/web/demo/recording/example.ts"
  },
  "devDependencies": {
    "@atelier/workspace-image": "workspace:*",
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "1.61.0",
    "bun-types": "1.3.14",
    "oxlint": "1.78.0",
    "typebox": "^1.0.57",
    "typescript": "6.0.3"
  }
}

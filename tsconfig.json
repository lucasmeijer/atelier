{
  "compilerOptions": {
    "target": "ES2023",
    "ignoreDeprecations": "6.0",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@atelier/core": ["packages/core/src/index.ts"],
      "@atelier/shared": ["packages/shared/src/index.ts"],
      "@atelier/browser/server": ["packages/browser/src/server/index.ts"],
      "@atelier/browser/client": ["packages/browser/src/client/index.ts"],
      "@atelier/browser": ["packages/browser/src/server/index.ts"],
      "@atelier/workspace-proxy/server": ["packages/workspace-proxy/src/server/index.ts"],
      "@atelier/workspace-proxy": ["packages/workspace-proxy/src/server/index.ts"],
      "@atelier/pi-config/server": ["packages/pi-config/src/server/index.ts"],
      "@atelier/pi-config": ["packages/pi-config/src/server/index.ts"],
      "@atelier/observable-terminal/server": ["packages/observable-terminal/src/server/index.ts"],
      "@atelier/observable-terminal/client": ["packages/observable-terminal/src/client/index.ts"],
      "@atelier/observable-terminal/shared": ["packages/observable-terminal/src/shared/index.ts"],
      "@atelier/observable-terminal": ["packages/observable-terminal/src/server/index.ts"],
      "@atelier/workspace-terminal/server": ["packages/workspace-terminal/src/server/index.ts"],
      "@atelier/workspace-terminal/client": ["packages/workspace-terminal/src/client/index.ts"],
      "@atelier/workspace-terminal": ["packages/workspace-terminal/src/index.ts"],
      "@atelier/vscode/server": ["packages/vscode/src/server/index.ts"],
      "@atelier/vscode/client": ["packages/vscode/src/client/index.ts"],
      "@atelier/vscode": ["packages/vscode/src/server/index.ts"]
    },
    "types": ["bun-types"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tools/**/*.ts"
  ]
}

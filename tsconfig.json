{
  "compilerOptions": {
    "target": "ES2023",
    "ignoreDeprecations": "6.0",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "paths": {
      "@atelier/core": ["./packages/core/src/index.ts"],
      "@atelier/shared": ["./packages/shared/src/index.ts"],
      "@atelier/design-system/action-item": ["./packages/design-system/src/action-item/action-item-html.ts"],
      "@atelier/design-system/action-item/client": ["./packages/design-system/src/action-item/action-item-controller.ts"],
      "@atelier/browser/server": ["./packages/browser/src/server/index.ts"],
      "@atelier/browser/client": ["./packages/browser/src/client/index.ts"],
      "@atelier/browser": ["./packages/browser/src/server/index.ts"],
      "@atelier/agent/server": ["./packages/agent/src/server/index.ts"],
      "@atelier/agent/client": ["./packages/agent/src/client/index.ts"],
      "@atelier/agent": ["./packages/agent/src/server/index.ts"],
      "@atelier/review/server": ["./packages/review/src/server/index.ts"],
      "@atelier/review/client": ["./packages/review/src/client/index.ts"],
      "@atelier/review": ["./packages/review/src/server/index.ts"],
      "@atelier/workspace": ["./packages/workspace/src/index.ts"],
      "@atelier/workspace/client": ["./packages/workspace/src/client/index.ts"],
      "@atelier/workspace/server/provisioning": ["./packages/workspace/src/server/provisioning-web.ts"],
      "@atelier/projects": ["./packages/projects/src/index.ts"],
      "@atelier/projects/server": ["./packages/projects/src/server/index.ts"],
      "@atelier/workspace-image": ["./packages/workspace-image/src/index.ts"],
      "@atelier/proxy-egress/server": ["./packages/proxy-egress/src/server/index.ts"],
      "@atelier/proxy-egress": ["./packages/proxy-egress/src/server/index.ts"],
      "@atelier/proxy-ingress/server": ["./packages/proxy-ingress/src/server/index.ts"],
      "@atelier/proxy-ingress": ["./packages/proxy-ingress/src/server/index.ts"],
      "@atelier/update/server": ["./packages/update/src/server/index.ts"],
      "@atelier/update/client": ["./packages/update/src/client/index.ts"],
      "@atelier/transcription": ["./packages/transcription/src/server/index.ts"],
      "@atelier/transcription/server": ["./packages/transcription/src/server/index.ts"],
      "@atelier/transcription/client": ["./packages/transcription/src/client/index.ts"],
      "@atelier/update": ["./packages/update/src/server/index.ts"],
      "@atelier/keypress-probe/server": ["./packages/keypress-probe/src/server/index.ts"],
      "@atelier/keypress-probe/client": ["./packages/keypress-probe/src/client/index.ts"],
      "@atelier/keypress-probe": ["./packages/keypress-probe/src/server/index.ts"],
      "@atelier/observable-terminal/server": ["./packages/observable-terminal/src/server/index.ts"],
      "@atelier/observable-terminal/client": ["./packages/observable-terminal/src/client/index.ts"],
      "@atelier/observable-terminal/shared": ["./packages/observable-terminal/src/shared/index.ts"],
      "@atelier/observable-terminal": ["./packages/observable-terminal/src/server/index.ts"],
      "@atelier/workspace-terminal/server": ["./packages/workspace-terminal/src/server/index.ts"],
      "@atelier/workspace-terminal/client": ["./packages/workspace-terminal/src/client/index.ts"],
      "@atelier/workspace-terminal": ["./packages/workspace-terminal/src/index.ts"],
      "@atelier/vscode/server": ["./packages/vscode/src/server/index.ts"],
      "@atelier/vscode/client": ["./packages/vscode/src/client/index.ts"],
      "@atelier/vscode": ["./packages/vscode/src/server/index.ts"]
    },
    "types": ["bun-types"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts"
  ]
}

#!/bin/sh
set -eu

export DISPLAY=${DISPLAY:-:99}
DESKTOP_DIR=/.atelier/desktop
GEOMETRY=${ATELIER_DESKTOP_GEOMETRY:-1440x900x24}
VNC_PORT=${ATELIER_DESKTOP_VNC_PORT:-5900}
WEB_PORT=${ATELIER_DESKTOP_WEB_PORT:-6080}

mkdir -p "$DESKTOP_DIR"

if pgrep -f "websockify.*$WEB_PORT" >/dev/null 2>&1 && pgrep -f "Xvfb $DISPLAY" >/dev/null 2>&1; then
  touch "$DESKTOP_DIR/enabled"
  exit 0
fi

if ! pgrep -f "Xvfb $DISPLAY" >/dev/null 2>&1; then
  nohup Xvfb "$DISPLAY" -screen 0 "$GEOMETRY" -ac > "$DESKTOP_DIR/xvfb.log" 2>&1 &
fi

sleep 1

if ! pgrep -f "openbox" >/dev/null 2>&1; then
  nohup openbox > "$DESKTOP_DIR/openbox.log" 2>&1 &
fi

if ! pgrep -f "x11vnc.*$VNC_PORT" >/dev/null 2>&1; then
  nohup x11vnc -display "$DISPLAY" -forever -shared -nopw -listen 127.0.0.1 -rfbport "$VNC_PORT" -xkb > "$DESKTOP_DIR/x11vnc.log" 2>&1 &
fi

sleep 1

if ! pgrep -f "websockify.*$WEB_PORT" >/dev/null 2>&1; then
  nohup websockify --web=/usr/share/novnc "0.0.0.0:$WEB_PORT" "127.0.0.1:$VNC_PORT" > "$DESKTOP_DIR/websockify.log" 2>&1 &
fi

touch "$DESKTOP_DIR/enabled"

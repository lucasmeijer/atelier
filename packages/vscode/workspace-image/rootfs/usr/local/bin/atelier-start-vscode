#!/bin/sh
set -eu

server_data_dir="${ATELIER_VSCODE_SERVER_DATA_DIR:-/home/atelier/.vscode-server}"
defaults_dir="${ATELIER_VSCODE_DEFAULTS_DIR:-/opt/atelier/vscode-defaults}"
extensions_dir="${ATELIER_VSCODE_EXTENSIONS_DIR:-/opt/atelier/vscode-extensions}"

seed_file() {
  src="$1"
  dst="$2"
  if [ -f "$src" ] && [ ! -e "$dst" ]; then
    mkdir -p "$(dirname "$dst")"
    cp "$src" "$dst"
  fi
}

# Seed remote/server-side VS Code defaults. Browser-local User settings are not
# controlled by code serve-web.
seed_file "$defaults_dir/Machine/settings.json" "$server_data_dir/data/Machine/settings.json"
seed_file "$defaults_dir/Machine/mcp.json" "$server_data_dir/data/Machine/mcp.json"

server_bin=""
if [ -d /home/atelier/.vscode/cli/serve-web ]; then
  server_bin="$(find /home/atelier/.vscode/cli/serve-web -path '*/bin/code-server' -type f | sort | tail -n 1)"
fi

set -- \
  --accept-server-license-terms \
  --host "${ATELIER_VSCODE_HOST:-0.0.0.0}" \
  --port "${ATELIER_VSCODE_PORT:-8000}" \
  --without-connection-token \
  --default-folder "${ATELIER_VSCODE_DEFAULT_FOLDER:-/work}" \
  --server-data-dir "$server_data_dir"

if [ -d "$extensions_dir" ]; then
  export VSCODE_EXTENSIONS="$extensions_dir"
fi

if [ -n "$server_bin" ]; then
  exec "$server_bin" "$@"
fi

exec code serve-web "$@"

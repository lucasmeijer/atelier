#!/bin/bash
set -euo pipefail

# The tmux pane and its exit-file writer stay outside this scope. Preserve the
# caller's terminal, directory, environment and identity; only resource priority
# changes. Each command gets a scope so OOM group killing leaves gateways alive.
exec sudo -n --preserve-env /usr/bin/env "PATH=$PATH" /usr/bin/systemd-run \
  --quiet --scope --collect --expand-environment=no --slice=atelierbash.slice \
  --unit="atelier-bash-$(cat /proc/sys/kernel/random/uuid)" \
  /bin/bash -ec '
    group=$(sed -n "s/^0:://p" /proc/self/cgroup)
    echo 1 > "/sys/fs/cgroup${group}/memory.oom.group"
    echo 500 > /proc/self/oom_score_adj
    exec /usr/bin/setpriv --reuid "$1" --regid "$2" --init-groups \
      /usr/bin/nice -n 10 -- "${@:3}"
  ' atelier-bash "$(id -u)" "$(id -g)" "$@"

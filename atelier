#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$HOME/.bun/bin:$PATH"

stdout_file="$(mktemp)"
stderr_file="$(mktemp)"
trap 'rm -f "$stdout_file" "$stderr_file"' EXIT

set +e
bun run "$SCRIPT_DIR/tools/atelier/src/main.ts" "$@" >"$stdout_file" 2>"$stderr_file"
status=$?
set -e

pretty_print() {
  python3 -m json.tool "$1" 2>/dev/null || cat "$1"
}

if [[ -s "$stdout_file" ]]; then
  pretty_print "$stdout_file"
fi

if [[ -s "$stderr_file" ]]; then
  pretty_print "$stderr_file" >&2
fi

exit "$status"
